# ns-record-notify settings.
#
# Easiest: run  ./scripts/init-env.sh --help  -- it creates .env from this file and
# generates every secret. To do it by hand, copy this file to .env, chmod 600 it,
# and fill in everything marked REQUIRED.
#
# Commented-out lines are optional and show their defaults.
# Changes take effect after:  docker compose up -d   (this drops live calls)

# ---- Network ----------------------------------------------------------------

# REQUIRED. This host's public IP as NetSapiens and the carrier see it (behind NAT:
# the router's public IP). It goes into the call setup, so a wrong value means calls
# connect but nobody hears anything.
EXTERNAL_IP=203.0.113.10

# The private subnet(s) this host sits on, so Asterisk can tell which peers are not local.
LOCAL_NET=10.0.0.0/8

# ---- NetSapiens (calls arrive from here) ------------------------------------

# REQUIRED. Every NetSapiens server that may send calls here: IPs or CIDRs, comma
# separated. Anything not listed is rejected. Use IPs rather than hostnames, which
# are only looked up once at startup.
NS_SIP_HOST=core1.example.netsapiens.com
NS_SIP_PORT=5060

# REQUIRED. The username and password NetSapiens must present when it sends a call;
# enter the same pair on the NetSapiens trunk. This stops anyone who can forge a
# NetSapiens source IP from placing calls on your carrier. 12+ characters.
# Generated by scripts/init-env.sh.
NS_AUTH_USER=
NS_AUTH_PASS=

# ---- Carrier (calls go to here) ---------------------------------------------

# REQUIRED. The carrier's gateway IPs, comma separated, primary first. Every call
# tries the first; the next is used only if that gateway fails (503 or unreachable).
#   192.0.2.10,192.0.2.11          a primary and one failover
#   192.0.2.10,192.0.2.11:5080     a gateway on its own port
#   192.0.2.0/24                   a CIDR: accepted from that range, but never dialled
CARRIER_SIP_HOST=sip.carrier.example.com
CARRIER_SIP_PORT=5060

# Only if the carrier wants a username and password instead of authorising your IP.
CARRIER_USER=
CARRIER_PASS=

# Failover tuning. The defaults suit most carriers.
#
# What counts as "this gateway failed". BUSY is left out on purpose: it normally means
# the destination is busy, and retrying would ring the same person twice.
#CARRIER_FAILOVER_ON=CONGESTION,CHANUNAVAIL
# Seconds between health pings (SIP OPTIONS) to each gateway. One that stops answering
# is skipped at once. Use 0 if your carrier does not answer OPTIONS, or it would be
# treated as down forever.
#CARRIER_QUALIFY_SECONDS=10
# Milliseconds to wait on a gateway that never answers before trying the next
# (6400-32000). Only matters until the next health ping notices it is down.
#CARRIER_RESPONSE_TIMEOUT_MS=16000

# ---- Call limits ------------------------------------------------------------

# REQUIRED in practice. Most simultaneous outbound calls; 0 means unlimited. Set the
# total a little above your busiest hour. The point is to cap the bill if someone gets
# in, not to shape traffic. Calls over the limit get a 503; emergency numbers are
# never limited.
MAX_CONCURRENT_CALLS=0
# The same limit per calling extension. Catches one compromised extension dialling
# out in bulk long before the total is reached.
MAX_CONCURRENT_PER_CALLER=0

# ---- Announcement -----------------------------------------------------------
# These override the same settings in config/rules.yaml. Unlike that file they are
# read only at startup, so a change needs  docker compose up -d.

# Seconds after the call is answered before the first announcement.
ANNOUNCE_INITIAL_DELAY_SECONDS=3

# Seconds from the start of one announcement to the start of the next.
ANNOUNCE_INTERVAL_SECONDS=30

# Digits that stop the announcement for the rest of the call. Use two: a lone * or 0
# can be pressed at a far-end menu by accident. Empty disables the feature.
DTMF_STOP_DIGITS=*9

# Who may press them: caller (the internal side), callee (the far party) or any.
DTMF_ACCEPT_FROM=any

# ---- Operator UI ------------------------------------------------------------

# It listens on 127.0.0.1 only. Reach it with:  ssh -L 8090:127.0.0.1:8090 you@the-vm
WEB_PORT=8090

# Login for the UI and its API: both or neither, 12+ characters. Generated by
# scripts/init-env.sh.
WEB_USER=
WEB_PASS=

# Listen address. Anything other than 127.0.0.1 is refused unless WEB_USER and
# WEB_PASS are set.
#WEB_HOST=127.0.0.1

# ---- Internal ---------------------------------------------------------------

# Login for Asterisk's local control interface, used only between the two containers.
# ARI_PASS must be 16+ characters; the placeholder below is rejected at startup.
# Generated by scripts/init-env.sh.
ARI_USER=announcer
ARI_PASS=change-me-please
ARI_PORT=8088

# debug, info, warn or error.
LOG_LEVEL=info

# ---- Advanced (rarely needed) -----------------------------------------------

# Only if the two trunks leave this host by DIFFERENT network paths -- say NetSapiens
# through a VPN and the carrier through the LAN -- so each needs its own address.
# Routing both the same way is simpler. See docs/design.md, "Media addressing".
#NS_BIND_IP=
#NS_EXTERNAL_IP=
#CARRIER_BIND_IP=
#CARRIER_EXTERNAL_IP=

# Turns the startup refusals (placeholder or short secrets, missing NetSapiens
# credentials) into warnings. For a lab on a private link only; scripts/preflight.sh
# fails if it is set.
#ALLOW_INSECURE_DEFAULTS=1
