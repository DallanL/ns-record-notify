# ---- Networking ----
# Public/reachable IP of this host, as seen by NetSapiens and the carrier.
EXTERNAL_IP=203.0.113.10
# Comma-separated local subnets (used for PJSIP NAT handling)
LOCAL_NET=10.0.0.0/8

# ---- NetSapiens side (calls arrive FROM here) ----
# Host(s)/IP(s) of the NetSapiens cores that will send us outbound calls.
# Comma-separate as many as you need; a CIDR works too. Every core that can send
# us traffic must be covered or its INVITEs are rejected as unidentified.
# Prefer IPs/CIDRs over hostnames -- see the README, hostnames are resolved once
# at load and a dead one costs you that host until the next reload.
#   NS_SIP_HOST=10.20.30.41,10.20.30.42
#   NS_SIP_HOST=10.20.30.0/24
NS_SIP_HOST=core1.example.netsapiens.com
NS_SIP_PORT=5060

# ---- Carrier side (calls go TO here) ----
# Also accepts a comma-separated list / CIDR, for carriers with several gateways.
CARRIER_SIP_HOST=sip.carrier.example.com
CARRIER_SIP_PORT=5060
# Leave user/pass blank for IP-authenticated trunks.
CARRIER_USER=
CARRIER_PASS=
# Set to the number/DID the carrier expects, or leave blank to pass through NetSapiens' caller ID.
CARRIER_FROM_USER=

# ---- ARI ----
ARI_USER=announcer
ARI_PASS=change-me-please
ARI_PORT=8088

# ---- Controller ----
WEB_PORT=8080
LOG_LEVEL=info
