# ---- Networking ----
# The address NetSapiens and your carrier send MEDIA to. This must also be the
# address your RTP leaves from -- if the two differ, the call connects and
# nobody hears anything. See "Media addressing" in the README.
EXTERNAL_IP=203.0.113.10
# Local subnets, so Asterisk knows which peers are not external.
LOCAL_NET=10.0.0.0/8

# ---- Split media paths (optional) ----
# Only needed when the two trunks leave this box by DIFFERENT interfaces, e.g.
# NetSapiens over a VPN/WireGuard tunnel and the carrier over the local WAN.
# external_media_address is a per-transport setting, so each path needs its own
# transport. Leave all four unset for the normal single-path case.
#   NS_BIND_IP=10.0.0.2
#   NS_EXTERNAL_IP=10.0.0.2
#   CARRIER_BIND_IP=10.0.0.3
#   CARRIER_EXTERNAL_IP=203.0.113.10

# ---- NetSapiens side (calls arrive FROM here) ----
# Host(s)/IP(s) of the NetSapiens cores that will send us outbound calls.
# Comma-separate as many as you need; a CIDR works too. Every core that can send
# us traffic must be covered or its INVITEs are rejected as unidentified.
# Prefer IPs/CIDRs over hostnames -- see the README, hostnames are resolved once
# at load and a dead one costs you that host until the next reload.
#   NS_SIP_HOST=10.20.30.41,10.20.30.42
#   NS_SIP_HOST=10.20.30.0/24
NS_SIP_HOST=core1.example.netsapiens.com
NS_SIP_PORT=5060

# Digest credentials NetSapiens must present on its INVITEs (and REGISTERs, if
# its trunk is set to register). Enter the same pair on the NetSapiens side.
#
# STRONGLY RECOMMENDED whenever NetSapiens reaches this box over the public
# internet. NS_SIP_HOST alone authenticates on source IP, which the sender
# controls: a spoofed packet from a NetSapiens address can place calls on your
# carrier trunk without ever receiving a reply. Digest auth requires answering a
# challenge we send to the real address, which a blind spoofer never sees.
#
# Leave both blank to keep IP-only trust (fine on a private link / WireGuard).
NS_AUTH_USER=
NS_AUTH_PASS=

# ---- Carrier side (calls go TO here) ----
# The carrier's gateways, comma separated, in the order to try them. List the
# failover IPs too: carrier-1 is dialled first, and the next only if it FAILS.
#   CARRIER_SIP_HOST=192.0.2.10,192.0.2.11              primary + failover
#   CARRIER_SIP_HOST=192.0.2.10,192.0.2.11:5080         a gateway on its own port
#   CARRIER_SIP_HOST=192.0.2.10,192.0.2.0/24            a CIDR is inbound-match only
# Prefer literal IPs over hostnames: a hostname is resolved once at startup, so a
# gateway that changes address stays broken until the container restarts.
CARRIER_SIP_HOST=sip.carrier.example.com
CARRIER_SIP_PORT=5060

# Which call outcomes mean "this gateway failed, try the next one". The default is
# right for almost everyone: CONGESTION is a 503 (gateway busy or overloaded) and
# CHANUNAVAIL is a gateway that is down or unreachable. BUSY is deliberately NOT
# here -- that is normally the destination being busy, and retrying it would ring
# the same person again. Add it only if your carrier reports overload as 486.
#CARRIER_FAILOVER_ON=CONGESTION,CHANUNAVAIL

# How long a gateway that never answers is waited on before moving to the next,
# in ms (6400-32000). Only matters in the gap before OPTIONS qualification notices
# a gateway is down. Lower is a faster rescue; it must stay well above the
# round-trip time to the carrier (T1 = this / 64, so 16000 -> 250ms).
#CARRIER_RESPONSE_TIMEOUT_MS=16000

# OPTIONS ping per gateway, in seconds; a gateway that stops answering is skipped
# instantly. Set 0 if your carrier does not answer OPTIONS -- otherwise it would
# be marked unavailable forever and never used.
#CARRIER_QUALIFY_SECONDS=10
# Leave user/pass blank for IP-authenticated trunks.
CARRIER_USER=
CARRIER_PASS=
# Set to the number/DID the carrier expects, or leave blank to pass through NetSapiens' caller ID.
CARRIER_FROM_USER=

# ---- ARI ----
ARI_USER=announcer
ARI_PASS=change-me-please
ARI_PORT=8088

# ---- Toll-fraud brakes ----
# Caps on simultaneous outbound calls. 0 disables a cap.
#
# Enforced in the dialplan BEFORE the Stasis() hop, so they still apply while
# the controller is down -- which is exactly the window fraud wants. Emergency
# destinations bypass both caps; a fraud brake must never be what stops a 911
# call. Over-limit calls get a 503, which NetSapiens reads as a route failure
# and can fail over on.
#
# Set MAX_CONCURRENT_CALLS a little above your real busy-hour peak. The point is
# not to shape traffic, it is to bound the bill if someone gets in.
MAX_CONCURRENT_CALLS=0
# Per originating caller ID. Catches the common case -- one compromised
# extension dialling out dozens of times at once -- long before the total cap.
MAX_CONCURRENT_PER_CALLER=0

# ---- Announcement behaviour ----
# These override the matching values in config/rules.yaml. Unlike that file they
# are read at startup only, so a change needs `docker compose up -d controller`
# rather than POST /api/reload. The controller logs which source each value came
# from when it starts.

# Seconds after the call is answered before the first playback.
ANNOUNCE_INITIAL_DELAY_SECONDS=3

# Seconds between the START of one playback and the start of the next. If the
# prompt is longer than this, the next play is skipped rather than overlapping.
ANNOUNCE_INTERVAL_SECONDS=30

# Digits someone on the call presses to stop the announcement for the rest of
# that call. Set empty (DTMF_STOP_DIGITS=) to disable the feature.
# Prefer two digits: this box observes DTMF but cannot swallow it, so the digits
# also reach the far end and a lone "*" risks being eaten by a far-end IVR.
DTMF_STOP_DIGITS=*9

# Who may press it: caller (internal NetSapiens-side user), callee (far party），
# or any.
DTMF_ACCEPT_FROM=any

# ---- Controller ----
WEB_PORT=8090
# The operator UI can stop announcements on live calls. It listens on loopback by
# default; reach it with:  ssh -L 8090:127.0.0.1:8090 you@the-vm
# WEB_HOST=0.0.0.0 is REFUSED unless WEB_USER and WEB_PASS are also set, and
# WEB_PASS must be at least 12 characters. scripts/init-env.sh generates them.
#WEB_HOST=127.0.0.1
WEB_USER=
WEB_PASS=

# The service refuses to start on a placeholder ARI_PASS, a short secret, or with
# NetSapiens digest auth unset -- see the README. Set this to 1 ONLY for a lab on a
# private link; it downgrades those refusals to warnings.
#ALLOW_INSECURE_DEFAULTS=1
LOG_LEVEL=info
